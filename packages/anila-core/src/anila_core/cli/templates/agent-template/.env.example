# Copy to .env and fill in values before running.

# CSP Platform base URL — must be reachable FROM this agent host (the agent
# rarely shares a machine with CSP; do NOT use localhost in prod).
# Used to derive JWKS: {CSP_BASE_URL}/.well-known/jwks.json
CSP_BASE_URL=http://localhost:8000

# Optional: PEM CA bundle for the JWKS HTTPS fetch (CSPKI). Never SSL_CERT_FILE.
# ANILA_CA_FILE=/path/to/cspki_ca_bundle.pem

# CSP API Key issued to this agent (get from CSP admin) — outbound LLM/proxy calls.
CSP_API_KEY=sk-your-agent-api-key

# Optional outbound agent→CSP credential (RAG search / callback). NOT used for
# inbound dispatch auth anymore (P2.1 uses Bearer dispatch JWT + JWKS).
# CSP_SERVICE_TOKEN=csk-issued-from-register-wizard
# ANILA_COLLECTION_ID=             # RAG agents: the collection bound at register

# Model name to use for LLM calls (must be registered in CSP model_registry)
MODEL=gpt-4o-mini

# Embedding model (if your agent does vector search)
EMBEDDING_MODEL=text-embedding-3-small

# Development mode: set to true to skip inbound dispatch-JWT checks locally
API_DEV_MODE=false
