# 複製成 .env 後填入。env 會覆寫 configs/*.yaml。

# --- 模型（本地 vLLM / OpenAI-compatible 端點）---
# 內網現況：gpt-oss-20b。api_key 對 vLLM 無作用，填 EMPTY。
ANILA_BASE_URL=http://gpt-oss-20b:8000/v1
ANILA_MODEL=gpt-oss-20b
ANILA_API_KEY=EMPTY

# --- 嵌入端點 embedding（model-infra，與上面 LLM 同類；跨功能共用）---
# 誰需要：① 長期記憶 memdir（ANILA_MEMORY=1）做 recall  ② 直連 DB 的 pgvector 檢索。
# 誰不需要：CSP HTTP 檢索——CSP 在伺服器端自己 embed，agent 完全不碰嵌入模型。
# 省略時 base_url / api_key 會退回上面的 ANILA_BASE_URL / ANILA_API_KEY。
# ANILA_EMBED_MODEL=nvidia/NV-embed-V2
# ANILA_EMBED_BASE_URL=
# ANILA_EMBED_API_KEY=

# 自簽內網 TLS：設 0/false/no/off 關閉憑證驗證（接進 chat 與 retriever 路徑）。預設 1。
ANILA_SSL_VERIFY=1

# 請求逾時（秒）。
ANILA_TIMEOUT=60

# 短期 session 與長期記憶存放處。預設 ./.anila。
ANILA_HOME=

# 日誌層級：DEBUG / INFO / WARNING / ERROR。
ANILA_LOG_LEVEL=INFO

# agent 名稱與最大工具迴圈輪數。
ANILA_AGENT_NAME=ANILA Agent
ANILA_MAX_TURNS=10

# --- 差異化功能（opt-in）---
# 長期記憶 memdir（多一次 embed/LLM 呼叫做 recall）。需 embed 端點（見上方 embedding 區）。
ANILA_MEMORY=0
# 端末自動抽取記憶（多一次 LLM 呼叫；存檔前去敏）。
ANILA_AUTO_MEMORY=0
# 接地引用模式：套 concise-cited output style（行內【來源：id】）。
ANILA_CITED=0
# 回應 persona：configs/output_styles 或內建（zh-tw-formal / concise-cited）。
ANILA_OUTPUT_STYLE=

# --- 短期 session 後端 ---
# sqlite（預設，本地檔）或 postgres（需 ANILA_SESSION_DSN）。
ANILA_SESSION_BACKEND=sqlite
# ANILA_SESSION_DSN=postgresql://<user>:<pass>@<host>:<port>/<db>

# ============================================================
# 檢索 retriever（設了才啟用；優先序 csp_http > anila_pgvector > 通用 pgvector > dummy）
# ============================================================

# 【兩條路徑共用】要查哪個 collection（正整數）。部署(service wrapper)與
# CLI(from_env) 都讀這個——它不綁 pgvector，光這個就能定位 CSP HTTP 檢索。
# ANILA_COLLECTION_ID=12

# --- (推薦) CSP 平台 HTTP retriever：免 DB 憑證，CSP 端強制認證 + RLS ---
# 注意：部署路徑與 CLI 路徑讀「不同」env 名：
#   CLI / from_env ：ANILA_CSP_BASE_URL + (ANILA_CSP_API_KEY 或 ANILA_API_KEY)
#   service wrapper：CSP_BASE_URL；in-task 憑證 = 入向 dispatch JWT（非靜態 csk-）
# ANILA_CSP_BASE_URL=https://<csp-host>
# ANILA_CSP_API_KEY=
# ANILA_CSP_MIN_SCORE=0.25           # 分數門檻；兩條路徑都吃，預設 0.25

# --- (替代) ANILA 原生 pgvector：直連 DB（裝 [pgvector] extra）---
# 只有走「直連 DB」才需要 PGVECTOR_URL；走上面 CSP HTTP「不需要」它。
# 光 ANILA_COLLECTION_ID 無法定位 DB，所以這條一定要連線字串。
# 這條會自己 embed query → 需設上方 embedding 區的 ANILA_EMBED_*。
# PGVECTOR_URL=postgresql://<user>:<pass>@<host>:<port>/<db>

# --- (替代) 通用 langchain_postgres pgvector ---
# PGVECTOR_COLLECTION=<collection name>

# --- service wrapper（CSP Router 派工）---
# CSP_BASE_URL=https://<csp-host>    # agent 回打 CSP 檢索／JWKS；部署路徑用這個（非 ANILA_CSP_BASE_URL）
# 入向認證 = Authorization: Bearer <dispatch JWT>（RS256／JWKS），不再要 CSP_SERVICE_TOKEN。
# In-task 檢索／trace callback 帶回**同一條** dispatch JWT；勿再設 csk- 當檢索 api_key。
# ANILA_AGENT_NAME=anila-agent
# PORT=8200

# Full Trace span 已移除。不要設 ANILA_TRACE_ENDPOINT。
