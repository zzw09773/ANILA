# Backend that the dev proxy points at. Override per-environment.
VITE_CSP_BACKEND=http://localhost:8000

# anila-studio service for /api/studio/* (slide-deck job pipeline).
# Only consumed by `vite.config.ts` for the dev proxy. Default is the
# anila-studio docker port mapping.
VITE_ANILA_STUDIO_BACKEND=http://localhost:8100

# ── anila-studio service base URL (browser-visible) ─────────────────
# Empty string = use the vite dev proxy / same-origin nginx reverse
# proxy in production (recommended). Set to an absolute URL such as
# https://anila-studio.example.com only when the SPA must call studio
# cross-origin (e.g. staging deploys with a separate hostname).
VITE_STUDIO_BASE_URL=

# 預設聊天模型在治理中心的「知識庫對話模型」角色指定，建置時不烘進映像。

# Base path under which the SPA is served. Default '/' for local dev.
# When the docker-compose stack runs ANILALM behind the ANILA reverse
# proxy at /anilalm/ this is set via the Dockerfile build arg.
# BASE_PATH=/anilalm/
