{# KEY_SUMMARY: executive brief — tight, scannable, generous whitespace.

   Visual cues:
   - sans-serif, slightly larger body text (12-14pt),
   - more vertical breathing room between sections,
   - muted secondary accent for less visual noise.
#}
{% extends "report/base.html.j2" %}
{% block document_class %}preset-key-summary{% endblock %}
{% block style_overrides %}
  body {
    font-size: 12.5pt;
    line-height: 1.8;
    color: #2a2f36;
  }
  .anila-report { max-width: 660px; }
  h1.report-title {
    font-size: 28pt;
    color: #2a2f36;
    border-bottom-color: #b8c2cc;
  }
  h2.section-heading {
    margin-top: 10mm;
    font-size: 17pt;
    font-weight: 600;
    color: #2a2f36;
  }
  .tldr {
    background: #fffbef;
    border-left-color: #c79a2b;
    font-size: 13pt;
    padding: 6mm;
  }
  .tldr .tldr-label { color: #8a6614; }
{% endblock %}
