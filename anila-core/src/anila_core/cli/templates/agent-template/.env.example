# Copy to .env and fill in values before running.

# CSP Platform base URL — must be reachable FROM this agent host (the agent
# rarely shares a machine with CSP; do NOT use localhost in prod).
CSP_BASE_URL=http://localhost:8000

# CSP API Key issued to this agent (get from CSP admin)
CSP_API_KEY=sk-your-agent-api-key

# This agent's OWN service token (csk-). Issue it from the CSP UI:
# /developer/agents → register wizard (Step 2) → "issue service token (csk-)".
# One key: it verifies inbound Router→agent dispatch AND authorises this agent's
# RAG search (scoped to its bound collection). Unset → fail-closed (the agent
# rejects every dispatch); set ANILA_ALLOW_NO_SERVICE_TOKEN=1 for LOCAL DEV only.
CSP_SERVICE_TOKEN=csk-issued-from-register-wizard
# ANILA_ALLOW_NO_SERVICE_TOKEN=1   # local dev only — skip inbound token check
# ANILA_COLLECTION_ID=             # RAG agents: the collection bound at register

# Model name to use for LLM calls (must be registered in CSP model_registry)
MODEL=gpt-4o-mini

# Embedding model (if your agent does vector search)
EMBEDDING_MODEL=text-embedding-3-small

# Development mode: set to true to skip auth checks locally
API_DEV_MODE=false
