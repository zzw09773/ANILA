# ── ANILA 主 repo 的 .gitignore ──────────────────────────────────────────────
# 子專案 (services/csp / packages/anila-core / apps/* / onyx) 各自的
# .gitignore 仍生效；此檔處理跨專案共通的忽略規則。

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
develop-eggs/
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt

# Test / lint / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.tox/

# Sprint 9 — anila-core's default Session SQLite store. The path is
# configurable via settings.session_db_path; default lives under
# `.anila/` next to wherever the agent / router process started.
.anila/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Virtualenvs
.venv/
.venv-*/
venv/
env/
ENV/

# Local SQLite 測試檔
.pytest-csp.db
*.sqlite3

# ── Node / 前端 ──────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.next/
out/
.nuxt/
.turbo/
.vite/
coverage/
.npm/
.yarn/
.pnpm-store/
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── 環境變數 / 機密 ──────────────────────────────────────────────────────────
# 只忽略實際的 .env，不要忽略範本
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
# 例外:卡片登入的 CSPKI CA bundle 是「公開憑證」(root + 中繼,非私鑰),
# 是 server 端驗卡的信任錨,必須隨碼一起交付。
!services/csp/app/services/cspki_ca_bundle.pem

# 舊版維運備份位置的防線。新版 anila-ops.sh 預設寫 repo 外且拒絕 repo
# 內覆寫；仍忽略既有 /backups/，避免歷史機密意外被加入。
/backups/

# ── IDE / 編輯器 ─────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# ── OS 產物 ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Claude Code 本地設定（user-local，不該共享）───────────────────────────────
.claude/settings.local.json
# Agent-tool isolated worktrees live inside the repo; never commit a nested copy.
.claude/worktrees/

# ── Logs / 暫存 ──────────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/

# ── runtime_logic（reference codebases — only README.md tracked）─────────────
# Sprint 9 X update: structure changed from a single TS reference at
# ``runtime_logic/src/`` to per-codebase subdirs. Both ``claude-code-src``
# (TypeScript Claude Code internals) and ``openai-agents-python`` (OpenAI
# Agents SDK) are studied locally for AgenticRAG enhancement work but
# their source trees stay out of this repo. Add a new subdir-style entry
# whenever a fresh reference codebase lands here.
runtime_logic/claude-code-src/
runtime_logic/openai-agents-python/
# Legacy single-tree paths kept for back-compat with branches still on
# the old layout — harmless to leave.
runtime_logic/src/
runtime_logic/vendor/
runtime_logic/node_modules/

# ── packages/anila-agent/templete (reference SDK snapshots — only .zip tracked) ─
# Three upstream SDK source snapshots packaged as zip in packages/anila-agent/
# templete/ (synced from zzw09773/anila-agent subtree). Developers unzip locally
# to read patterns + port logic into anila_agent/, but the unzipped trees
# stay out of git. Same model as runtime_logic/ above.
packages/anila-agent/templete/claude-code-src/
packages/anila-agent/templete/openai-agents-python/
packages/anila-agent/templete/antigravity-sdk-python/

# ── runtime data: n8n workflow assets / uploads ───────────────────────────────
# Static templates (e.g. fina./) and user uploads served by nginx at /static
# and /uploads. These are workflow-specific runtime data, not source code —
# back them up out-of-band. README.md is tracked so the directory layout
# stays self-documenting for fresh checkouts.
share/static/
share/uploads/
share-dev/static/
share-dev/uploads/
# code-server 的工作目錄（C3 收斂後，預設不再掛 repo root）。
# 由 ops 自行決定要塞什麼進這個 sandbox；不 commit 內容。
share/codeserver-sandbox/

# ── Misc dev tooling ──────────────────────────────────────────────────────────
# Observer / loop process locks
.observer.lock
*.observer.lock


# Onyx upstream clone — handed off to the agent dev team for ongoing
# maintenance. Their code, their repo. Kept on disk for local reference
# but not under our version control. The handover spec we owe them
# stays tracked at docs/onyx/onyx-target-system-api-spec.md and
# docs/onyx/onyx-application-plan.md.
onyx/
n8n_DATA

# 產出物：生成的簡報不入庫
*.pptx

# ── 模型權重 (models/model = ANILA_HF_DIR 預設;權重數百 GB 不入 git) ────
models/model/*
!models/model/.gitkeep
