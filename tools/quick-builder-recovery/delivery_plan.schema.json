{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anila:offline-patch-plan:v1",
  "title": "ANILA 離線 patch 與來源核定清冊",
  "description": "僅表達待審資料與證據參照；通過 schema 不代表來源核定、映像身分或部署許可。跨欄位規則由 delivery_plan.py 驗證。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "base_revision", "target_revision", "source_bundle_sha256", "changes", "sources", "images", "worker", "acceptance"],
  "properties": {
    "schema": {"const": "anila.offline-patch-plan/v1"},
    "base_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "target_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_bundle_sha256": {"$ref": "#/$defs/nullableHash"},
    "changes": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "before_sha256", "after_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1536},
          "before_sha256": {"$ref": "#/$defs/nullableHash"},
          "after_sha256": {"$ref": "#/$defs/nullableHash"}
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "artifact_sha256", "source_url", "publisher", "license_expression", "author_country", "control_country", "approval"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,95}$"},
          "version": {"$ref": "#/$defs/nullableText"},
          "artifact_sha256": {"$ref": "#/$defs/nullableHash"},
          "source_url": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
          "publisher": {"$ref": "#/$defs/nullableText"},
          "license_expression": {"$ref": "#/$defs/nullableText"},
          "author_country": {"$ref": "#/$defs/nullableCountryClaim"},
          "control_country": {"$ref": "#/$defs/nullableCountryClaim"},
          "approval": {
            "type": "object", "additionalProperties": false,
            "required": ["decision", "reviewer_id", "evidence_sha256"],
            "properties": {
              "decision": {"enum": ["pending", "approved", "rejected"]},
              "reviewer_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 96},
              "evidence_sha256": {"$ref": "#/$defs/nullableHash"}
            }
          }
        }
      }
    },
    "images": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source_id", "archive_sha256", "image_digest", "sbom_sha256", "license_review_sha256"],
        "properties": {
          "id": {"enum": ["pgvector", "pgbouncer", "csp-credential-dirs", "csp", "redis", "ingestion-worker", "router", "nginx", "pptx-renderer", "hr-lookup", "anila-studio", "anilalm", "anila-ui", "codeserver", "n8n", "asr-gateway"]},
          "source_id": {"type": "string", "pattern": "^image:[a-z0-9-]+$"},
          "archive_sha256": {"$ref": "#/$defs/nullableHash"},
          "image_digest": {"$ref": "#/$defs/nullableImageDigest"},
          "sbom_sha256": {"$ref": "#/$defs/nullableHash"},
          "license_review_sha256": {"$ref": "#/$defs/nullableHash"}
        }
      }
    },
    "worker": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "image_digest", "checks"],
      "properties": {
        "scope": {"const": "target-worker-image"},
        "image_digest": {"$ref": "#/$defs/nullableImageDigest"},
        "checks": {
          "type": "object", "additionalProperties": false,
          "required": ["parser-packages", "tesseract", "chi_tra", "eng", "libreoffice", "pandoc", "fonts", "chromium", "offline-egress-policy"],
          "properties": {
            "parser-packages": {"$ref": "#/$defs/nullableHash"},
            "tesseract": {"$ref": "#/$defs/nullableHash"},
            "chi_tra": {"$ref": "#/$defs/nullableHash"},
            "eng": {"$ref": "#/$defs/nullableHash"},
            "libreoffice": {"$ref": "#/$defs/nullableHash"},
            "pandoc": {"$ref": "#/$defs/nullableHash"},
            "fonts": {"$ref": "#/$defs/nullableHash"},
            "chromium": {"$ref": "#/$defs/nullableHash"},
            "offline-egress-policy": {"$ref": "#/$defs/nullableHash"}
          }
        }
      }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_verification_sha256", "file_restore_rehearsal_sha256", "regression_report_sha256", "rollback_review_sha256"],
      "properties": {
        "source_verification_sha256": {"$ref": "#/$defs/nullableHash"},
        "file_restore_rehearsal_sha256": {"$ref": "#/$defs/nullableHash"},
        "regression_report_sha256": {"$ref": "#/$defs/nullableHash"},
        "rollback_review_sha256": {"$ref": "#/$defs/nullableHash"}
      }
    }
  },
  "$defs": {
    "nullableHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "nullableImageDigest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "nullableText": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "nullableCountryClaim": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"}
  }
}
