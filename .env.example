# ANILA 平台環境。複製成 .env 後只改這個檔。
# 專案名稱來自 COMPOSE_PROJECT_NAME。啟動：
#   docker compose up -d
# 改過設定後同樣用 docker compose up -d 重建容器。
# 模型、agent、信任主機、文件解析與語音位址在治理中心設定，不寫在這裡。

# ── 站台 ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=anila
# 對外名稱。入向 Host 白名單與 nginx 都從這一顆衍生。
ANILA_HOST=<your-intranet-fqdn-or-ip>

# ── 密鑰（必填；用 openssl rand 產生，不要用範例字）────────────────────────
SECRET_KEY=<openssl rand -hex 32>
ADMIN_PASSWORD=<openssl rand -base64 24>
CSP_DB_PASSWORD=<openssl rand -hex 32>
CSP_APP_DB_PASSWORD=<openssl rand -hex 32>
CODESERVER_PASSWORD=<openssl rand -base64 24>
CODESERVER_WORKSPACE=../..

# ── 登入 ──────────────────────────────────────────────────────────────────
# card-only 仍保留擁有者的密碼登入。正式部署拒絕其他值。
ANILA_AUTH_MODE=card-only
# 首刷就成為擁有者的員工編號，CSV。
CARD_INITIAL_OWNERS=<your-employee-id,or-csv-list>
# 正式部署必須是 0。不要把 CARD_CA_BUNDLE_PATH 指到測試 CA。
CARD_DEV_TRUST_TEST_CA=0

# ── 啟動姿態 ──────────────────────────────────────────────────────────────
# 1 會關掉正式部署的密鑰檢查。正式環境保持 0。
ANILA_ALLOW_DEV_SECRET=0
# production 或 prod 才啟用模型 http fail-closed 的部署旗標。
ANILA_ENV=production
# 0＝啟動時照常跑資料庫遷移。
ANILA_SKIP_STARTUP_MIGRATIONS=0
# 1＝本機沒有模型容器，preflight 不檢查本機模型服務。模型仍在治理中心登錄。
ANILA_REMOTE_MODELS=1
# 放行 http 模型端點。模型走 https 時改 0。
ANILA_ALLOW_HTTP_ENDPOINT=1
# 放行私網 IP 端點。端點是 FQDN 時保持 0。
ANILA_ALLOW_PRIVATE_ENDPOINT=0
# 放行 agent 的 http 端點（內網 MLSteam）。
ANILA_ALLOW_HTTP_AGENT_ENDPOINT=0
# 放行明文 grpc://。只有要註冊 Triton 時改 1。
ANILA_ALLOW_GRPC_ENDPOINT=0
# 繁中正規化與查詢擴展。0＝關閉。
ANILA_ZH_NORMALIZE=1
ANILA_QUERY_EXPANSION=1

# ── 模型閘道 ──────────────────────────────────────────────────────────────
# 治理中心登錄的 https 模型若要 Bearer，填這裡。空＝不帶。
MODEL_GATEWAY_API_KEY=
# 內部 CA 的 PEM 路徑（容器內路徑）。空＝用系統 CA。
ANILA_MODEL_CA_FILE=

# ── 備份目錄（宿主機路徑）────────────────────────────────────────────────
# 不設就用 repo 的 share/backups。容器內寫入路徑固定是 /backups。
# ANILA_BACKUP_DIR=

# ── 逾時與解析 ────────────────────────────────────────────────────────────
# CSP 對上游模型的秒數。
LLM_TIMEOUT=300
EMBEDDING_TIMEOUT=30
# worker 自己的嵌入逾時與每批段數。
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
# 文件解析的 OCR 語言與逾時。位址在治理中心。
DOCLING_OCR_LANGS=ch_tra,en
DOCLING_TIMEOUT_SECONDS=120
DOCLING_CONNECT_TIMEOUT_SECONDS=5
# 沒有視覺角色時圖說會略過。true＝有角色才寫圖說。掃描 PDF 的文字辨識是 Docling。
ENABLE_IMAGE_CAPTIONS=false

# ── 語音探針（位址在治理中心；要開 gateway 才加 --profile asr）────────────
ASR_PROBE_TIMEOUT_SECONDS=8
ASR_PROBE_CONNECT_TIMEOUT_SECONDS=3
ASR_PARTIALS_ENABLED=1
ASR_MAX_SESSION_SECONDS=300
ASR_OPENCC_MODE=off

# ── n8n（預設不起；COMPOSE_PROFILES=ops 才起來）──────────────────────────
N8N_TLS_REJECT_UNAUTHORIZED=1
N8N_NODE_FUNCTION_ALLOW_EXTERNAL=axios,lodash,dayjs,xlsx
