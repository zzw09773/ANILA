# === [分支設定檔] main — 通用開發基線 (SSOT) ===
# 用途:帳密／OIDC、隔離 dev stack 與通用功能開發；不可作正式部署設定。
# 程式碼已收斂為單一 anila-redesign 版本,分支之間只有此 .env.example 環境設定檔不同。
# 登入模式純由下方 config 旗標決定 (ENABLE_CARD_LOGIN / REQUIRE_CARD_LOGIN_ONLY)。
# ANILA Platform — main 開發用 root .env 範本
# ============================================================================
# 複製成 .env 並填入正式值:
#   cp .env.example .env
#
# 模式:**development**。只搭配隔離的 `compose.dev.yaml`；正式部署必須使用
# downstream 的具名 profile、外部 secret/state 路徑與 ANILA_IMAGE_* content ID。
# 不得把本檔的 dev opt-in 複製到任何 production 環境。
# ============================================================================

# ── 啟動安全檢查 ──────────────────────────────────────────────────────────
# 0 (prod) = startup_security 對 dev 預設值 (SECRET_KEY / ADMIN_PASSWORD /
#  CSP_SERVICE_TOKEN / DB_PASSWORD / INTERNAL_PLATFORM_API_KEY / CODESERVER_PASSWORD)
#  直接 RuntimeError 拒絕啟動。
# 1 (dev)  = 僅 warn,允許 dev 預設值繼續跑。
ANILA_ALLOW_DEV_SECRET=1
# F6 executable posture contract.  The formal air-gap deployment additionally
# writes ANILA_IMAGE_* sha256 content IDs from PLATFORM-IMAGE-LOCK.tsv; do not
# hand-copy mutable image tags into those generated variables.
ANILA_DEPLOYMENT_PROFILE=development
# Break-glass only: change profile to prod-intranet-card-breakglass while
# REQUIRE_CARD_LOGIN_ONLY stays true, and set all three time-bounded audit fields.
# ANILA_BREAK_GLASS_OWNER=<named-system-owner>
# ANILA_BREAK_GLASS_TICKET=<incident-ticket>
# ANILA_BREAK_GLASS_EXPIRES_AT=<RFC3339-with-timezone-within-24h>

# ── url_guard SSRF opt-in ─────────────────────────────────────────────────
# development 允許明確的 HTTP endpoint，但私網 IP 仍只用
# ANILA_TRUSTED_HOSTS 點名放行；不開整段 RFC1918。loopback / link-local /
# metadata 永遠擋，不受 flag 影響。dev compose 會自行覆寫 private opt-in。
ANILA_ALLOW_HTTP_ENDPOINT=1
ANILA_ALLOW_PRIVATE_ENDPOINT=0

# ── Slice 6 旗標分域 ──────────────────────────────────────────────────────
# ANILA_ENV=production → 「模型」endpoint 的 http 一律 fail-closed,不受任何
# 旗標放行 (doc 04 硬規則:正式模型 = HTTPS + API Key)。正式部署必設。
# agent endpoint 的 http 放行改走 AGENT 專用旗標 (內網 MLSteam agent 是純
# http NodePort → 設 1);legacy ANILA_ALLOW_HTTP_ENDPOINT 對 agent 仍有效
# 但會記 deprecation warning。
ANILA_ENV=development
ANILA_ALLOW_HTTP_AGENT_ENDPOINT=1

# 出向 endpoint 白名單 (CSV)。模型 gateway 的 FQDN 解析出來是私網 IP
# (10.53.100.12),url_guard 的 DNS 解析檢查會擋 → 點名放行。
# trusted 內的 host 跳過私網 IP / single-label / DNS 解析檢查。
ANILA_TRUSTED_HOSTS=aiagent2.ai.ncsist.org.tw,gpt-oss-20b,gemma4,nv-embed-proxy,flux2-dev-agent,host.docker.internal

# ── CSP 核心 secret ───────────────────────────────────────────────────────
# 全部 [REQUIRED in prod] — docker-compose 用 ${VAR:?must be set},缺值直接 fail。
# 生成: openssl rand -hex 32 (產 64 hex chars)
CSP_SECRET_KEY=<openssl rand -hex 32>
CSP_SERVICE_TOKEN=<openssl rand -hex 32>

# 初始 admin 帳號密碼 (auto_seed 建立)。card-only 模式下本機帳密登入是 404,
# 這個帳號主要是 auto_seed 內部 owner 掛載點,但 startup_security 仍強制非
# dev 預設值 (changeme/password/admin 都會被擋)。
ADMIN_PASSWORD=<openssl rand -base64 24>

# Browser session cookie posture. Production and both compose stacks terminate
# TLS at nginx and must keep this true: CSP/Router/Studio then accept only
# Secure, Path=/, host-only ``__Host-anila_*`` cookies. False is reserved for
# direct HTTP TestClient/local processes and selects distinct ``anila_dev_*``
# names; formal startup refuses it.
COOKIE_SECURE=true

# ── 資料庫密碼 ────────────────────────────────────────────────────────────
# CSP_DB_PASSWORD     = postgres superuser 'csp' (migration 連線 + csp-db 初始化)
# CSP_APP_DB_PASSWORD = runtime role 'csp_app' (RLS-enforced,app 全部連線走它)
# 兩把都用 hex — 會嵌進 DATABASE_URL,避免 URL 特殊字元。
# 只在 csp-pgdata volume **首次初始化**時生效;既有 DB 改值要手動 ALTER ROLE。
CSP_DB_PASSWORD=<openssl rand -hex 32>
CSP_APP_DB_PASSWORD=<openssl rand -hex 32>

# ── 內部 service-to-service token (auto_seed 寫入 ingestion-worker user) ──
# 生成: printf "sk-internal-" && openssl rand -hex 24
INTERNAL_PLATFORM_API_KEY=<sk-internal-<openssl rand -hex 24>>

# ── code-server (內網開發工具;預設不啟動) ────────────────────────────────
# 生成密碼: openssl rand -base64 24
CODESERVER_PASSWORD=<openssl rand -base64 24>
# 正式 compose 不會自動啟動；workspace 固定掛載 share/codeserver-sandbox,
# 不再提供指向 repo root 的 CODESERVER_WORKSPACE 覆寫。需要時把獨立 clone 放進
# sandbox,再執行 deploy-prod.sh codeserver-up。

# ── 內網 hostname (2026-07 定案:主平台與工具分來源) ───────────────────────
# 下列四個 FQDN 都指向 10.53.100.15 (請 IT 加內網 DNS A record)。工具不可
# 改回主站 subpath，否則其 active content 會重新取得 CSP session 的同源權限。
# TLS 用既有 *.ai.ncsist.org.tw wildcard 正式憑證 (從 server.pfx 抽,見
# runbook),放在 repo 外 ANILA_TLS_CERTS_DIR/server.{crt,key}。
# nginx Host allowlist 已有 *.ncsist.org.tw wildcard,conf 不用改;
# 公司 PC 信任 NCSIST CA → 瀏覽器無憑證警告。
# DNS 尚未配好時用工作站 hosts 檔或 curl --resolve 測試；不要把三個工具 host
# 改成 IP 或主平台 host，否則 canonical URL、TLS 與 origin 隔離會失效。
ANILA_HOST=anila.ai.ncsist.org.tw
# main 的隔離 dev stack 對外入口是 localhost:8443；不可讓 dev callback
# 或 auto-seed link 指向正式內網 origin。
SITE_URL=https://localhost:8443
# 正式 JWT/TLS 私鑰只放 repo 外的受控 state 目錄。路徑必須是絕對路徑；
# intranet-deploy.sh 預設使用 $XDG_STATE_HOME/anila 或 ~/.local/state/anila。
ANILA_STATE_DIR=/var/lib/anila
ANILA_SECRETS_DIR=/var/lib/anila/secrets
ANILA_TLS_CERTS_DIR=/var/lib/anila/tls
# dev compose 也不得回寫 repo-local infra/nginx/certs。
ANILA_DEV_TLS_CERTS_DIR=/var/lib/anila/dev-tls
N8N_HOST=n8n.ai.ncsist.org.tw
N8N_EDITOR_BASE_URL=https://n8n.ai.ncsist.org.tw/
# n8n 需要 canonical URL 產生連結，但 nginx 目前仍對三種 webhook route 回 404。
N8N_WEBHOOK_URL=https://n8n.ai.ncsist.org.tw/
GITLAB_HOST=gitlab.ai.ncsist.org.tw
CODESERVER_HOST=code.ai.ncsist.org.tw
# GitLab HTTPS 與 UI 使用原生認證；另在指定內網介面開 GitLab Shell SSH，
# 並由主機 firewall 限制核准的開發者網段。不要設 0.0.0.0。
GITLAB_SSH_BIND_IP=10.53.100.15
GITLAB_SSH_PORT=2222

# ── branch SSO: 中科院憑證卡登入 ──────────────────────────────────────────
# 內網 prod 唯一登入方式。使用者 PC 上的中華電信 HiPKI 元件 (localhost:16888,
# PKCS#11 API + HTTP wrapper) 處理 PIN + 卡片硬體簽章；backend 會驗 CMS
# SignerInfo、challenge nonce 與釘選 CSPKI 憑證鏈後才抽 employee_id。
ENABLE_CARD_LOGIN=false
REQUIRE_CARD_LOGIN_ONLY=false
JWT_ISSUER=https://anila.internal/csp
JWT_AUDIENCE=anila-platform
JWT_LEEWAY_SECONDS=60
REVOCATION_RECONCILE_INTERVAL_SECONDS=5
ENABLE_PUBLIC_SHARE=true
ENABLE_MEMORY=true
PUBLIC_SHARE_MAX_TTL_HOURS=168

# CARD_INITIAL_OWNERS: CSV 員工編號清單。列在裡面的人第一次刷卡建為
# role="owner" + is_approved=True (bootstrap)。其他人走 pending →
# 完成註冊 (填 department) → admin 核准。**至少要列一個自己的員工編號**
# 否則 docker-compose ${CARD_INITIAL_OWNERS:?...} 會 fail-fast。
CARD_INITIAL_OWNERS=<your-employee-id,or-csv-list>
CARD_CRL_REQUIRED=false
CARD_CRL_BUNDLE_PATH=/etc/anila/pki/card-crl-bundle.pem
CARD_CRL_MAX_AGE_HOURS=24
CARD_CRL_SOURCE=<offline-crl-source-and-sync-owner>
CARD_REQUIRED_EKU_OID=1.3.6.1.5.5.7.3.2
CARD_REQUIRED_CERT_POLICY_OIDS=<required-card-policy-oids>

# ── n8n (保留的內網開發／自動化服務) ────────────────────────────────────
# Code Node 模組白名單寫死,避免變成任意 require() 的 RCE 平台。
# TLS 驗證預設開,要連自簽 endpoint 請逐節點設 self-signed CA。
N8N_TLS_REJECT_UNAUTHORIZED=1
N8N_NODE_FUNCTION_ALLOW_EXTERNAL=axios,lodash,dayjs,xlsx
# N8N_NODE_FUNCTION_ALLOW_BUILTIN=crypto,url

# n8n 2.x owner 由正式環境變數管理，fresh volume 不會留下公開 signup 競速。
# bcrypt 內含 $，寫入 .env 時務必用單引號，例如：
#   N8N_OWNER_PASSWORD_HASH='$2b$12$...'
# 可在受控管理機使用 `htpasswd -bnBC 12 ''` 產生後移除前綴冒號。
N8N_OWNER_EMAIL=<n8n-owner@internal.invalid>
N8N_OWNER_FIRST_NAME=ANILA
N8N_OWNER_LAST_NAME=Owner
N8N_OWNER_PASSWORD_HASH='<bcrypt-hash>'
N8N_ENCRYPTION_KEY=<openssl rand -hex 32>

# GitLab fresh install 的 root 初始密碼；既有 volume 不會被此值覆寫。
GITLAB_ROOT_PASSWORD=<openssl rand -base64 32>
# webhook ingress 尚未核准；不要另開 host port 或 nginx bypass。

# ── 模型 endpoint (內網拓撲:模型在 10.53.100.12,平台在 10.53.100.15) ────
# deploy-prod.sh preflight 用:1 = 模型在遠端主機,跳過本機 model container
# 檢查,改 curl 下面的 *_BASE_URL 探測可達性。
ANILA_REMOTE_MODELS=1
# 內網模型不直連 — 模型容器沒開 port,統一走 My-OpenAI-Frontend gateway:
#   https://aiagent2.ai.ncsist.org.tw (=10.53.100.12:443) 的 /v1。
# 憑證是公司正式核發、綁 FQDN → **必須用 FQDN 連**,用 IP 連會過不了
# hostname 驗證。base URL 不要加 /v1 結尾,proxy 自己拼。
# 若 csp 容器內解析不了該 FQDN (內網 DNS 沒配),在 compose csp 的
# extra_hosts 加 "aiagent2.ai.ncsist.org.tw:10.53.100.12"。
# model 名必須用 gateway 的 RESPONSE_ID (大小寫敏感):
#   LLM       = openai/gpt-oss-20b
#   embedding = nvidia/nv-embed-v2  (≠ ANILA 預設的 nvidia/NV-embed-V2!)
LOCAL_LLM_MODEL=openai/gpt-oss-20b
LOCAL_LLM_BASE_URL=https://aiagent2.ai.ncsist.org.tw
LOCAL_EMBEDDING_MODEL=nvidia/nv-embed-v2
LOCAL_EMBEDDING_BASE_URL=https://aiagent2.ai.ncsist.org.tw

# gateway 的 /v1 全路由要 API key (Bearer)。請在 10.53.100.12 平台的
# 管理介面簽發一把給 ANILA 專用的 key 填這裡。
MODEL_GATEWAY_API_KEY=<在 .12 平台簽發>

# 內網沒有 gemma4 → 設空字串,auto_seed 跳過該 entry 不註冊。
GEMMA4_BASE_URL=
# Router primary LLM (compose 預設 gemma4)。
LLM_MODEL=openai/gpt-oss-20b
# ANILALM 前端預設聊天模型 (build arg,compose 預設 gemma4)。
ANILALM_DEFAULT_CHAT_MODEL=openai/gpt-oss-20b
# 事實抽取 (memory_service) 用的 LLM。留空則 compose 預設對齊 LOCAL_LLM_MODEL
# (= 上方 .12 gpt-oss 的註冊名);程式另有 fallback 到任一 active LLM。內網
# 千萬不能是 gemma4(未部署),設這行或留給 compose 預設皆可。
MEMORY_LLM_MODEL=openai/gpt-oss-20b

# ── 模型 https 的 CA 信任 ─────────────────────────────────────────────────
# gateway 憑證是公司 (NCSIST) 內部 CA 核發 — 不在公共信任鏈,csp 不認,
# 呼叫會 CERTIFICATE_VERIFY_FAILED。要放的是 **CA chain (root +
# intermediate)**,不是 gateway 的 leaf 憑證 (OpenSSL 預設不把 CA 簽的
# leaf 當信任錨點)。CA 官方下載點 (leaf 憑證 AIA 欄位寫的,內網應可達):
#   http://repository.ncsist.org.tw/certs/NCSISTCA.cer
#   (.cer 可能是 DER 格式,轉 PEM: openssl x509 -inform der -in NCSISTCA.cer -out model-ca.pem)
# 備案 1:任一台公司網域 PC 的憑證存放區匯出「中科院憑證管理中心 - G1」。
# 備案 2:進場後抓 chain (前提是 gateway 有送中繼憑證):
#   openssl s_client -connect aiagent2.ai.ncsist.org.tw:443 -showcerts \
#     </dev/null 2>/dev/null
# 存成 ./share/pki/model-ca.pem 後先在 host 驗一次再開:
#   curl --cacert share/pki/model-ca.pem https://aiagent2.ai.ncsist.org.tw/health
# 然後打開這行 (路徑是容器內路徑):
# ANILA_MODEL_CA_FILE=/etc/anila/pki/model-ca.pem

# ── 本機模型 stack 路徑 (infra/models/docker-compose.yml 用) ──────────────
# 慣例 (§17.1 重組):權重放 <repo>/models/model (= ANILA_HF_DIR 預設,
# 相對 compose 檔解析成 ../../models/model);模型設定檔在 infra/models/src。
# 權重放別處才需要覆寫。dev 機的 models/model 內是 symlink → 舊路徑,免設。
# ANILA_HF_DIR=/data/Huggingface
# ANILA_MODELSRC_DIR=/data/model-src

# ── 影像理解 (VLM) ────────────────────────────────────────────────────────
# ingestion 的圖片 caption 需要 VLM (試用機用 gemma4)。內網唯一 LLM 是
# gpt-oss-20b (純文字),沒有 VLM → caption 關掉,圖片以 [image] 處理。
# 將來內網有 VLM 再開:ENABLE_IMAGE_CAPTIONS=true + VISION_MODEL=<vlm-name>。
ENABLE_IMAGE_CAPTIONS=false

# ── FLUX 圖像生成 (內網預設停用) ──────────────────────────────────────────
# 內網 (10.53.100.12) 沒有 FLUX 服務 → 兩個變數**設成空字串**:
#   FLUX_AGENT_BASE_URL 空 → auto_seed 跳過 image-generator (Router 不會
#     dispatch 到一個打不通的 dead agent)
#   FLUX_BACKEND_URL 空    → anila-studio 的 get_flux_provider() 回
#     None,studio 圖像 pipeline 乾淨停用
# 將來內網若部署 FLUX,填上 endpoint 並把 host 加進 ANILA_TRUSTED_HOSTS。
#
# 2026-07 起 FLUX 統一走 **OpenAI 相容 Images API**(雲端算力中心部署):
#   POST {FLUX_BACKEND_URL}/v1/images/generations
#   {model, prompt, n, size, response_format:"b64_json"} → {created, data:[{b64_json}]}
# FLUX_BACKEND_URL 指到伺服器根或含 /v1 皆可(client 沒看到版本段會自動補 /v1)。
FLUX_AGENT_BASE_URL=
FLUX_BACKEND_URL=
# OpenAI Images API request 的 model 欄位(依雲端算力中心公布的模型名填)。
FLUX_MODEL=flux.2-dev
# FLUX 服務的 API key;有值 anila-studio / flux2-dev-agent 才帶
# Authorization: Bearer,留空 = 不帶(本機 flux2-dev 免驗)。
FLUX_API_KEY=
