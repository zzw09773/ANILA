# ANILA 平台環境。複製成 .env 後只改這個檔。
# 專案名稱來自 COMPOSE_PROJECT_NAME。啟動：
#   docker compose up -d
# 改過設定後同樣用 docker compose up -d 重建容器。
# 模型、agent、信任主機、文件解析與語音位址在治理中心設定，不寫在這裡。

# ── 站台 ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=anila
# 對外名稱。入向 Host 白名單與 nginx 都從這一顆衍生。
ANILA_HOST=<your-intranet-fqdn-or-ip>

# ── 密鑰（必填；用 openssl rand 產生，不要用範例字）────────────────────────
SECRET_KEY=<openssl rand -hex 32>
ADMIN_PASSWORD=<openssl rand -base64 24>
CSP_DB_PASSWORD=<openssl rand -hex 32>
CSP_APP_DB_PASSWORD=<openssl rand -hex 32>
CODESERVER_PASSWORD=<openssl rand -base64 24>
CODESERVER_WORKSPACE=../..

# ── 登入 ──────────────────────────────────────────────────────────────────
# card-only 仍保留擁有者的密碼登入。正式部署拒絕其他值。
ANILA_AUTH_MODE=card-only
# 首刷就成為擁有者的員工編號，CSV。
CARD_INITIAL_OWNERS=<your-employee-id,or-csv-list>
# 正式部署必須是 0。不要把 CARD_CA_BUNDLE_PATH 指到測試 CA。
CARD_DEV_TRUST_TEST_CA=0

# ── 啟動姿態 ──────────────────────────────────────────────────────────────
# 1 會關掉正式部署的密鑰檢查。正式環境保持 0（部署腳本會擋）。
ANILA_ALLOW_DEV_SECRET=0

# ── 出向連線（院內模型與 agent 都在私網，以下四個都要開）───────────────
# 真正能連哪幾台，由治理中心「信任主機」決定；這四個只是允許的連線種類。
# 放行 http 的模型端點（院內閘道不是每台都有 https）。
ANILA_ALLOW_HTTP_ENDPOINT=1
# 私網總開關（172.16.x、10.x）。打開之後，目標仍必須在治理中心
# 「信任主機」裡：IP 字面要整段相符，名稱則是解析到私網的那台。
# 未列入信任清單的私網位址不會放行。
ANILA_ALLOW_PRIVATE_ENDPOINT=1
# 放行 MLSteam 上 agent 的 http 端點。
ANILA_ALLOW_HTTP_AGENT_ENDPOINT=1
# 放行 grpc://（嵌入模型走 Triton gRPC）。
ANILA_ALLOW_GRPC_ENDPOINT=1

# ── 模型閘道 ──────────────────────────────────────────────────────────────
# 治理中心登錄的模型若要共用 Bearer，填這裡。空＝不帶。
MODEL_GATEWAY_API_KEY=
# 院內 CA 的 PEM（容器內路徑）。模型走院內憑證的 https 時才填；空＝系統 CA。
# 取得方式見 docs/runbooks/intranet-deployment-runbook.md。
ANILA_MODEL_CA_FILE=

# ── 備份 ──────────────────────────────────────────────────────────────────
# 不設就寫到 repo 的 share/backups（另一台用 rsync 拉走）。
# ANILA_BACKUP_DIR=

# ── n8n（最後演練才起：COMPOSE_PROFILES=ops）────────────────────────────
N8N_TLS_REJECT_UNAUTHORIZED=1
N8N_NODE_FUNCTION_ALLOW_EXTERNAL=axios,lodash,dayjs,xlsx

# 嵌入逾時、LLM 逾時、繁中正規化、檢索擴展在治理中心設定頁改
# （嵌入是 proxy.embedding_timeout，LLM 是 proxy.llm_timeout）。
# ingestion-worker 的 EMBEDDING_TIMEOUT_SECONDS 是另一道期限：
# worker 等待 CSP /v1/embeddings 的上限，跟治理中心那顆分開，較短的先到。
# 警報寄信、模型、agent、信任主機、文件解析與語音位址也在治理中心設定。
