{# Base template for Studio reports.

   Per-preset templates inherit this and override:
   - ``{% block document_class %}`` — body class for CSS theming
   - ``{% block style_overrides %}`` — preset-specific CSS overrides
   - ``{% block section_decorations %}`` — optional pedagogical / executive
     callout boxes injected by the renderer

   The template intentionally does NOT depend on any external CSS file
   so the PDF rendering pipeline (Playwright → chromium → page.pdf) needs
   no network access and offline DOCX conversion via pypandoc works on the
   same self-contained HTML.

   Recursion is handled in-template via a Jinja2 macro so the same code
   path handles ##/###/#### levels uniformly. Depth >= 3 collapses to
   <h4> to avoid heading inflation.
#}<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <title>{{ spec.title }}</title>
  <style>
    @page {
      size: A4;
      margin: 22mm 18mm 22mm 18mm;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      font-family: "Noto Sans CJK TC", "Noto Sans TC", "PingFang TC",
                   "Microsoft JhengHei", sans-serif;
      color: #1a1f24;
      line-height: 1.7;
      font-size: 12pt;
    }
    .anila-report {
      max-width: 720px;
      margin: 0 auto;
      padding: 12mm 0;
    }
    h1.report-title {
      font-size: 26pt;
      font-weight: 700;
      margin: 0 0 6mm 0;
      letter-spacing: 0.01em;
      border-bottom: 2px solid #1a1f24;
      padding-bottom: 4mm;
    }
    .tldr {
      background: #f5f7fa;
      border-left: 4px solid #2a4a73;
      padding: 4mm 5mm;
      margin: 0 0 8mm 0;
      font-size: 11.5pt;
      line-height: 1.7;
    }
    .tldr .tldr-label {
      display: block;
      font-weight: 700;
      letter-spacing: 0.08em;
      font-size: 9.5pt;
      color: #2a4a73;
      margin-bottom: 2mm;
      text-transform: uppercase;
    }
    h2.section-heading {
      font-size: 16pt;
      font-weight: 700;
      margin: 8mm 0 3mm 0;
      color: #1a1f24;
    }
    h3.section-heading {
      font-size: 13pt;
      font-weight: 700;
      margin: 5mm 0 2mm 0;
      color: #2a4a73;
    }
    h4.section-heading {
      font-size: 11.5pt;
      font-weight: 700;
      margin: 4mm 0 2mm 0;
      color: #444b54;
    }
    .section-body { margin: 0 0 3mm 0; }
    .section-body p { margin: 0 0 2mm 0; }
    .section-body ul, .section-body ol { padding-left: 6mm; margin: 0 0 3mm 0; }
    .section-body li { margin: 0 0 1mm 0; }
    .section-body code {
      background: #eef1f5;
      padding: 0.5mm 1.5mm;
      border-radius: 1mm;
      font-family: "Source Code Pro", "Consolas", monospace;
      font-size: 10.5pt;
    }
    .section-body pre {
      background: #2a2f36;
      color: #f6f8fb;
      padding: 3mm 4mm;
      border-radius: 1.5mm;
      overflow-x: auto;
      font-size: 10pt;
    }
    .section-body blockquote {
      border-left: 3px solid #b8c2cc;
      padding: 1mm 4mm;
      margin: 2mm 0;
      color: #4a525c;
    }
    .references-section {
      margin-top: 12mm;
      padding-top: 4mm;
      border-top: 1px solid #b8c2cc;
    }
    .references-section h2 {
      font-size: 14pt;
      margin: 0 0 3mm 0;
    }
    .references-list {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 10.5pt;
    }
    .references-list li {
      margin: 0 0 2mm 0;
      padding-left: 8mm;
      text-indent: -8mm;
    }
    .references-list .ref-n {
      display: inline-block;
      width: 6mm;
      font-weight: 700;
      color: #2a4a73;
    }
    .references-list .ref-filename { font-weight: 600; }
    .references-list .ref-excerpt {
      display: block;
      color: #545b63;
      font-size: 10pt;
      margin-top: 1mm;
      margin-left: 8mm;
    }
    .citation-marker {
      vertical-align: super;
      font-size: 0.78em;
      color: #2a4a73;
      text-decoration: none;
      padding: 0 0.5mm;
    }
    .footer {
      margin-top: 10mm;
      padding-top: 3mm;
      border-top: 1px solid #d8dde3;
      font-size: 9pt;
      color: #6a727b;
      display: flex;
      justify-content: space-between;
    }
    {% block style_overrides %}{% endblock %}
  </style>
</head>
<body class="{% block document_class %}preset-base{% endblock %}">
  <article class="anila-report">
    <h1 class="report-title">{{ spec.title }}</h1>

    <section class="tldr">
      <span class="tldr-label">TL;DR · 重點摘要</span>
      <div>{{ spec.tldr }}</div>
    </section>

    {%- macro render_section(section, depth) -%}
      {%- set level = depth if depth <= 4 else 4 -%}
      <h{{ level }} class="section-heading">{{ section.heading }}</h{{ level }}>
      {%- if section.content_markdown -%}
        <div class="section-body">{{ section.content_html|safe }}</div>
      {%- endif -%}
      {%- for sub in section.subsections -%}
        {{ render_section(sub, depth + 1) }}
      {%- endfor -%}
    {%- endmacro -%}

    {% for section in sections_with_html %}
      {{ render_section(section, 2) }}
    {% endfor %}

    {% block section_decorations %}{% endblock %}

    {% if spec.references %}
    <section class="references-section">
      <h2>引用來源</h2>
      <ol class="references-list">
        {% for ref in spec.references %}
        <li id="ref-{{ ref.n }}">
          <span class="ref-n">[{{ ref.n }}]</span>
          <span class="ref-filename">{{ ref.filename }}</span>
          {% if ref.chunk_id is not none %}
          <span class="ref-chunk-id">· chunk #{{ ref.chunk_id }}</span>
          {% endif %}
          {% if ref.excerpt %}
          <span class="ref-excerpt">{{ ref.excerpt }}</span>
          {% endif %}
        </li>
        {% endfor %}
      </ol>
    </section>
    {% endif %}

    <footer class="footer">
      <span>ANILA LM · {{ preset_label }}</span>
      <span>{{ generated_at_str }}</span>
    </footer>
  </article>
</body>
</html>
