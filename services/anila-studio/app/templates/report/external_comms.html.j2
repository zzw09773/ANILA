{# EXTERNAL_COMMS: clean corporate / customer-facing tone.

   Visual cues:
   - sans-serif, professional palette (teal + dark slate),
   - generous padding and rounded section blocks,
   - subdued reference list (smaller, lower contrast).
#}
{% extends "report/base.html.j2" %}
{% block document_class %}preset-external-comms{% endblock %}
{% block style_overrides %}
  body {
    font-family: "Noto Sans CJK TC", "Noto Sans TC", "Inter",
                 "Helvetica Neue", sans-serif;
    color: #1f2630;
    line-height: 1.75;
    font-size: 11.5pt;
  }
  h1.report-title {
    color: #0e4f57;
    border-bottom-color: #0e4f57;
  }
  h2.section-heading {
    color: #0e4f57;
    font-weight: 600;
  }
  h3.section-heading { color: #156876; }
  .tldr {
    background: #ecf6f6;
    border-left-color: #0e4f57;
  }
  .tldr .tldr-label { color: #0e4f57; }
  .references-section h2 { color: #0e4f57; }
  .references-list {
    font-size: 9.5pt;
    color: #4a525c;
  }
{% endblock %}
