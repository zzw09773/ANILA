# ── docling-service standalone（獨立 GPU 主機）環境範例 ─────────────────────
# 複製成 .env：cp .env.example .env
# ⚠ 祕密零外洩：以下一律是佔位字串，不是真的可用值。真值絕不進 repo。

# 必填、fail-loud（缺了容器拒絕啟動）：與平台側 csp / ingestion-worker 的
# DOCLING_SERVICE_TOKEN 一致。用 `openssl rand -hex 32` 產一組長亂數（64 字元）。
# ⚠ 佔位值是根目錄慣例的角括號：角括號原樣複製過去是不能用的——cp && up 會
# 壞掉，而不是安靜地成功。不是「填了等於沒填」的活憑證。
DOCLING_SERVICE_TOKEN=<openssl rand -hex 32>

# 必填、fail-loud：權重目錄（fetch-docling-weights.sh 的產出，含
# DOCLING-WEIGHTS-MANIFEST.txt）解到 host 的這個路徑；容器以 :ro 掛載。
DOCLING_MODEL_HOST_DIR=/data/anila/docling-weights

# 卡號（預設 0）。docling 的 EasyOCR + layout model 與 LLM / ASR 搶同一張卡時
# 推論延遲會互相干擾，operator 按主機卡號調整。
DOCLING_GPU_DEVICE_ID=0

# 對外埠（預設 9100）。平台主機的 DOCLING_URL 要對到這個埠。
DOCLING_PORT=9100
# 綁定位址（預設 0.0.0.0 = 平台主機在別台、必須能連進來）。務必用防火牆把
# 來源限縮到平台主機 IP。
DOCLING_BIND=0.0.0.0

# ── 以下可選，預設已夠（離線 1／繁中+英／表格結構開／圖片描述關）──────────
# DOCLING_LOCAL_FILES_ONLY=1
# DOCLING_OCR_LANGS=ch_tra,en
# DOCLING_TABLE_STRUCTURE=true
# DOCLING_PICTURE_DESCRIPTION=false
# LOG_LEVEL=INFO
