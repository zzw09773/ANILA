# asr-decoder 外部版(獨立 GPU 主機)的環境設定範例。
#   cp .env.example .env && vi .env
# 內部版(與平台同機)不用這個檔,設定在 infra/models/docker-compose.yml。
#
# ⚠ .env 已被 repo 的 .gitignore 擋下,但這是 PUBLIC repo —— 真實密鑰
#   永遠不要寫進 .env.example。

ANILA_DEPLOYMENT_PROFILE=production

# ── 必填 ────────────────────────────────────────────────────────────────
# 與 asr-gateway 共享的密鑰。外部版走純 http,這是唯一的一道防線。
#   openssl rand -hex 32
ASR_DECODER_TOKEN=

# ── 模型 ────────────────────────────────────────────────────────────────
# medium | large-v3 | 或已轉檔的 CTranslate2 模型目錄(掛進 /var/anila/asr-models)
ASR_MODEL_SIZE=medium
# air-gap:1 = 禁止對 HuggingFace 出向,權重缺了就 fail loud
ASR_LOCAL_FILES_ONLY=1
# 權重在 host 上的位置(內含 model.bin 等轉檔產物)
ASR_MODEL_HOST_DIR=./models

# ── 硬體 ────────────────────────────────────────────────────────────────
ASR_DEVICE=cuda
# V100(Volta)→ float16。Volta 無 int8 tensor core,int8 更慢。
# Turing 以後(T4/A10/L4/H100)才考慮 int8_float16 省 VRAM。
ASR_COMPUTE_TYPE=float16
# 釘哪張卡(nvidia-smi 的 index)。不要跟 LLM 共用同一張。
ASR_GPU_DEVICE_ID=0

# ── 網路 ────────────────────────────────────────────────────────────────
# 對外 port。務必用防火牆把來源限縮到平台主機 IP。
ASR_DECODER_PORT=9000
ASR_DECODER_BIND=0.0.0.0

LOG_LEVEL=INFO
