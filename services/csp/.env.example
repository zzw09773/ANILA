# ============================================================
# CSP Platform 環境變數配置
# 複製此檔為 .env 後修改：cp .env.example .env
# ============================================================

# ---------- 基本設定 ----------
SECRET_KEY=your-secret-key-change-this-in-production

# ---------- 資料庫（PostgreSQL）----------
DATABASE_URL=postgresql://csp:csp_password@postgres:5432/csp
DB_USER=csp
DB_PASSWORD=csp_password
DB_NAME=csp

# ---------- JWT 設定 ----------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ANILA_AUTH_MODE=password

# ---------- 管理員帳號（首次啟動自動建立）----------
ADMIN_PASSWORD=changeme

# ---------- Proxy 設定 ----------
EMBEDDING_TIMEOUT=30
LLM_TIMEOUT=300

# ---------- Nginx 設定 ----------
# Nginx 對外 port（預設 80）
NGINX_PORT=80
# 使用者瀏覽器存取的基底 URL，用於平台卡片連結
SITE_URL=http://localhost

# 模型與 agent 在治理中心登錄，啟動時不從環境變數寫入。
